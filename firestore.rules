// ═══════════════════════════════════════════════════════
//  GLITZ OF HORIZON — FIRESTORE SECURITY RULES
//  firestore.rules
//
//  THIS FILE ISN'T AUTO-DEPLOYED. Paste its contents into:
//  Firebase Console → your project → Firestore Database → Rules
//  tab → replace everything → Publish.
//
//  Until this is published, every read/write fails with
//  "Missing or insufficient permissions" if your project is in
//  locked/production mode (the default) — which is exactly the
//  error you just hit.
// ═══════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ─────────────────────────────────────────
    // Read: any signed-in user (needed for friend profile view,
    // username search, and the presence/leaderboard join).
    // Write: only your own doc.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Your own private friend list — nobody else can read or
      // write it, including which uids you've added.
      match /friends/{friendUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Match history entries (bandit + pvp_local results) — you
      // write your own, nobody else can read or write them.
      match /matchHistory/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── PRESENCE ──────────────────────────────────────
    // Read: any signed-in user (needed for nearby discovery,
    // online-status light, and the leaderboard).
    // Write: only your own presence doc.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── MATCHES (PvP Online + direct challenges) ───────
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.hostUid == request.auth.uid
                        || resource.data.guestUid == request.auth.uid
                        || (resource.data.guestUid == null
                            && request.resource.data.guestUid == request.auth.uid));
      allow delete: if request.auth != null
                    && (resource.data.hostUid == request.auth.uid
                        || resource.data.guestUid == request.auth.uid);

      match /actions/{seq} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && (get(/databases/$(database)/documents/matches/$(matchId)).data.hostUid == request.auth.uid
                          || get(/databases/$(database)/documents/matches/$(matchId)).data.guestUid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // ── WORLD FEED ──────────────────────────────────────
    // Read: any signed-in user.
    // Create: admin_post requires isAdmin==true on your user doc.
    //         battle_report is written directly by match clients —
    //         trusted for now given the small early user base; a
    //         Cloud Function would be the hardened version later.
    // Update: allowed (comment-count increments come through here).
    match /worldFeed/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && (
                      request.resource.data.type == 'battle_report'
                      || (request.resource.data.type == 'admin_post'
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
                    );
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
